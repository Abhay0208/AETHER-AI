# AETHER environment configuration
# Copy to .env and adjust. Never commit real secrets.

AETHER_PORT=5467
AETHER_HOST=127.0.0.1
AETHER_DEBUG=false

# Change these in production before first launch.
AETHER_SECRET_KEY=replace-with-a-random-string
AETHER_ENCRYPTION_KEY=replace-with-64-hex-chars

# Data directory (default: ./data)
# AETHER_DATA_DIR=./data

# Provider API keys are added through the UI, not here.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
